{
  "expo": {
    "name": "AgapAlert",
    "slug": "agapalert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AgapAlert uses your location to show verified flood risks, river water levels, and nearest evacuation shelters in your area.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AgapAlert monitors your location in the background to deliver immediate early warnings during flash floods and typhoons.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#070F1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AgapAlert monitors your location to deliver life-saving flash flood and typhoon warnings."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#06B6D4",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ]
  }
}
