# AgapAlert Web / Desktop Environment Variables
# Replace with your Supabase Project Settings (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gmail SMTP Email Notifications
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (You must have 2-Step Verification enabled on your Google account)
GMAIL_USER=agapalert.system@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
